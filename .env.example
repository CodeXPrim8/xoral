# XORAL — Supabase environment variables
# Copy to .env.local and fill in values from your Supabase project dashboard.
# Full guide: supabase/SETUP.md

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use either the anon key (eyJ...) or publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Production: https://xoral-iota.vercel.app
# Auth Site URL: https://xoral-iota.vercel.app
# Auth Redirect URLs: https://xoral-iota.vercel.app/** and http://localhost:3000/**

# XORAL PARTY
# Cryptographically sign ticket QR payloads. Required in production.
PARTY_TICKET_SECRET=replace-with-a-long-random-secret
# Staff check-in PIN for /party/check-in
PARTY_CHECKIN_PIN=replace-me
# Public site URL used in ticket emails and Paystack return/webhook URLs
NEXT_PUBLIC_SITE_URL=https://xoral-iota.vercel.app
PARTY_SITE_URL=https://xoral-iota.vercel.app
# paystack | flutterwave | opay | mock
# mock is blocked when NODE_ENV=production
PARTY_PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_live_or_sk_test_your_key
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
OPAY_MERCHANT_ID=
OPAY_SECRET_KEY=
OPAY_PUBLIC_KEY=
# Live: https://liveapi.opaycheckout.com  Test: https://testapi.opaycheckout.com
OPAY_BASE_URL=https://liveapi.opaycheckout.com
# Ticket emails after Paystack confirms payment
RESEND_API_KEY=
PARTY_FROM_EMAIL=Xoral Party <tickets@your-domain.com>
# Optional. If set, vendors must enter this code to register.
PARTY_VENDOR_INVITE=
# Required on Vercel so orders, tickets, and sales survive between requests.
# Run supabase/RUN-IN-SUPABASE-party-live.sql first.
SUPABASE_SERVICE_ROLE_KEY=
